    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.47.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
